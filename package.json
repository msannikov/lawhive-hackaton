{
  "name": "deposit-return-toolset",
  "version": "1.0.0",
  "description": "Document-driven UK tenancy-deposit-return system: VLM (Claude/Gemini) extracts facts from unstructured documents, then a deterministic decision tree maps them to a concrete toolset (next action + deadline).",
  "type": "module",
  "scripts": {
    "example": "node --experimental-strip-types examples/fromDocuments.ts",
    "typecheck": "tsc --noEmit",
    "demo:capture": "node --experimental-strip-types Tools/scripts/captureAssessment.ts",
    "demo:capture:claude": "node --experimental-strip-types Tools/scripts/captureAssessmentClaude.ts",
    "demo:studio": "npm run studio --prefix Tools",
    "demo:render": "npm run render --prefix Tools",
    "demo:render:claude": "npm run render:claude --prefix Tools",
    "demo:render:recourse": "npm run render:recourse --prefix Tools"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "5.4"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.98.0",
    "@google/generative-ai": "^0.24.1"
  }
}
