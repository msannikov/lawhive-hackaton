# Copy to .env and fill in. .env is gitignored; never commit real keys.

# Claude (default provider). Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Gemini (alternative provider).
GEMINI_API_KEY=

# Force a provider: claude | gemini | mock. If unset, auto-selects from the
# available key, falling back to the offline mock.
EXTRACTION_PROVIDER=
