# Copy to .env and fill in. The POC runs fully offline with the defaults below.

# Anthropic API key. Leave blank to run from the recorded fixture (offline).
ANTHROPIC_API_KEY=

# 1 = always use the recorded fixture (offline, deterministic demo).
# 0 = call the live Anthropic API (requires ANTHROPIC_API_KEY).
USE_FIXTURE=1

# Model used for live generation. Latest Opus by default.
MODEL_ID=claude-haiku-4-5

# Backend port.
PORT=8000
